    background: linear-gradient(to top, color-mix(in srgb, var(--sf-paper) 94%, transparent) 55%, color-mix(in srgb, var(--sf-paper) 60%, transparent) 80%, transparent);
  }
  [data-theme="simplefolio"] .sf-site-role { font-size: 15px; font-weight: 600; letter-spacing: -0.01em; color: var(--sf-ink); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Expanded browser window */
  html:has(#sf-browser[open]) { overflow: hidden; }
  [data-theme="simplefolio"] .sf-browser {
    position: fixed; inset: 0; margin: auto; width: min(1320px, calc(100vw - 48px)); height: calc(100vh - 48px); height: calc(100dvh - 48px);
    max-width: none; max-height: none; padding: 0; overflow: hidden; display: none; flex-direction: column;
    color: var(--sf-text); background: var(--sf-paper); border: 1px solid var(--sf-rule); border-radius: 6px;
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.55); text-align: left;
  }
  [data-theme="simplefolio"] .sf-browser[open] { display: flex; }
  [data-theme="simplefolio"] .sf-browser::backdrop { background: rgba(0, 0, 0, 0.55); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  [data-theme="simplefolio"][data-mode="light"] .sf-browser::backdrop { background: rgba(20, 20, 20, 0.28); }
  [data-theme="simplefolio"] .sf-browser-bar {
    flex: none; display: flex; align-items: center; gap: 10px; height: 52px; padding: 0 12px 0 18px;
    background: var(--sf-wash); border-bottom: 1px solid var(--sf-rule);
  }
  [data-theme="simplefolio"] .sf-dot { width: 12px; height: 12px; padding: 0; border: 0; border-radius: 50%; background: var(--sf-rule); flex: none; }
  [data-theme="simplefolio"] .sf-dot--close { background: #ff6159; cursor: pointer; }
  [data-theme="simplefolio"] .sf-dot--close + .sf-dot { background: #ffbd2e; }
  [data-theme="simplefolio"] .sf-dot--close + .sf-dot + .sf-dot { background: #28c941; }
  [data-theme="simplefolio"] .sf-browser-nav { display: flex; gap: 2px; margin-left: 10px; }
  [data-theme="simplefolio"] .sf-browser-step,
  [data-theme="simplefolio"] .sf-browser-close {
    display: grid; place-items: center; width: 32px; height: 30px; padding: 0; border: 1px solid transparent; border-radius: 4px;
    background: none; color: var(--sf-ink); font: 500 15px/1 var(--sf-mono); cursor: pointer;
  }
  [data-theme="simplefolio"] .sf-browser-step:hover:not(:disabled),
  [data-theme="simplefolio"] .sf-browser-close:hover { border-color: var(--sf-rule); background: var(--sf-paper); }
  [data-theme="simplefolio"] .sf-browser-step:disabled { color: var(--sf-rule); cursor: default; }
  [data-theme="simplefolio"] .sf-browser-url {
    flex: 1; min-width: 0; display: flex; align-items: center; gap: 8px; height: 32px; padding: 0 12px; margin: 0 6px;
    background: var(--sf-paper); border: 1px solid var(--sf-rule); border-radius: 4px; color: var(--sf-graphite);
    font-family: var(--sf-mono); font-size: 12.5px; white-space: nowrap; overflow: hidden;
  }
  [data-theme="simplefolio"] .sf-browser-url svg { flex: none; color: var(--sf-in); }
  [data-theme="simplefolio"] .sf-browser-url span { overflow: hidden; text-overflow: ellipsis; }
  [data-theme="simplefolio"] .sf-browser-open {
    flex: none; padding: 8px 12px; border: 1px solid var(--sf-rule); border-radius: 4px; background: var(--sf-paper);
    font-size: 13px; font-weight: 600; color: var(--sf-ink); white-space: nowrap;
  }
  [data-theme="simplefolio"] .sf-browser-open:hover { border-color: var(--sf-ink); }
  [data-theme="simplefolio"] .sf-browser-open[hidden] { display: none; }
  [data-theme="simplefolio"] .sf-browser-body { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) 440px; }
  [data-theme="simplefolio"] .sf-browser-page { min-height: 0; overflow-y: auto; overscroll-behavior: contain; background: var(--sf-display); }
  [data-theme="simplefolio"] .sf-browser-page img { display: block; width: 100%; height: auto; }
  [data-theme="simplefolio"] .sf-browser-offline {
    height: 100%; min-height: 320px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;
    background-image: radial-gradient(var(--sf-dot) 1px, transparent 1.3px); background-size: 22px 22px;
  }
  [data-theme="simplefolio"] .sf-browser-offline span { font-size: 160px; font-weight: 700; letter-spacing: -0.06em; line-height: 1; color: var(--sf-rule); }
  [data-theme="simplefolio"] .sf-browser-offline p { margin: 0; font-family: var(--sf-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sf-muted); }
  [data-theme="simplefolio"] .sf-browser-exp:focus { outline: none; }
  [data-theme="simplefolio"] .sf-browser-exp {
    min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 32px 32px 40px;
    border-left: 1px solid var(--sf-rule); background: var(--sf-paper);
  }
  [data-theme="simplefolio"] .sf-browser-label { margin: 0 0 12px; font-family: var(--sf-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sf-ash); }
  [data-theme="simplefolio"] .sf-browser-title { margin: 0 0 8px; font-size: 30px; font-weight: 700; letter-spacing: -0.045em; line-height: 1.08; color: var(--sf-ink); }
  [data-theme="simplefolio"] .sf-browser-meta { margin: 0 0 20px; padding-bottom: 20px; border-bottom: 1px solid var(--sf-rule); font-family: var(--sf-mono); font-size: 12px; color: var(--sf-primary); }
  ::view-transition-group(sf-browser) { animation-duration: 0.45s; animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1); }

  /* Projects */
  [data-theme="simplefolio"] .sf-proj-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px 40px; text-align: left; }
  [data-theme="simplefolio"] .sf-proj { min-width: 0; }
  [data-theme="simplefolio"] .sf-proj:only-child { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 0 40px; align-items: start; }
  [data-theme="simplefolio"] .sf-proj:only-child > .sf-shot-link { grid-row: 1 / span 4; }
  [data-theme="simplefolio"] .sf-proj:only-child .sf-shot { margin-bottom: 0; }
  [data-theme="simplefolio"] .sf-proj .sf-shot { margin-bottom: 24px; }
  [data-theme="simplefolio"] .sf-proj .sf-project-lead { margin-bottom: 0; }

  /* Posts (X timeline) */
  [data-theme="simplefolio"] .sf-posts { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 40px; align-items: start; text-align: left; }
  [data-theme="simplefolio"] .sf-posts-label { margin: 0 0 12px; font-family: var(--sf-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sf-ash); }
  [data-theme="simplefolio"] .sf-posts-text { margin: 0 0 24px; font-size: 20px; line-height: 1.45; letter-spacing: -0.015em; color: var(--sf-ink); }
  [data-theme="simplefolio"] .sf-posts-list { display: grid; gap: 20px; }
  [data-theme="simplefolio"] .sf-post { padding: 22px 24px 18px; }
  [data-theme="simplefolio"] .sf-post-head { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
  [data-theme="simplefolio"] .sf-post-avatar { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--sf-rule); flex: none; }
  [data-theme="simplefolio"] .sf-post-who { display: flex; flex-direction: column; min-width: 0; line-height: 1.3; }
  [data-theme="simplefolio"] .sf-post-who b { display: inline-flex; align-items: center; gap: 4px; font-size: 15px; font-weight: 600; color: var(--sf-ink); }
  [data-theme="simplefolio"] .sf-post-check { color: var(--sf-primary); }
  [data-theme="simplefolio"] .sf-post-who span { font-family: var(--sf-mono); font-size: 12px; color: var(--sf-muted); }
  [data-theme="simplefolio"] .sf-post-x { margin-left: auto; color: var(--sf-muted); display: grid; place-items: center; width: 34px; height: 34px; border-radius: 4px; transition: color 0.2s, background 0.2s; }
  [data-theme="simplefolio"] .sf-post-x:hover { color: var(--sf-ink); background: var(--sf-glass); }
  [data-theme="simplefolio"] .sf-post-text { margin: 0 0 16px; font-size: 15.5px; line-height: 1.6; color: var(--sf-ink); white-space: pre-line; overflow-wrap: anywhere; }
  [data-theme="simplefolio"] .sf-post-text a { color: var(--sf-primary); }
  [data-theme="simplefolio"] .sf-post-photos { display: grid; gap: 6px; margin-bottom: 14px; border: 1px solid var(--sf-rule); border-radius: 4px; overflow: hidden; }
  [data-theme="simplefolio"] .sf-post-photos img { display: block; width: 100%; height: auto; }
  [data-theme="simplefolio"] .sf-post-foot { display: flex; align-items: center; gap: 18px; font-family: var(--sf-mono); font-size: 12px; color: var(--sf-muted); }
  [data-theme="simplefolio"] .sf-post-foot a { margin-left: auto; color: var(--sf-primary); }
  [data-theme="simplefolio"] .sf-posts-fallback {
    min-height: 220px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px;
    color: var(--sf-muted); font-family: var(--sf-mono); font-size: 13px; transition: color 0.2s;
  }
  [data-theme="simplefolio"] .sf-posts-fallback:hover { color: var(--sf-ink); }

  /* GitHub contributions */
  [data-theme="simplefolio"] .sf-gh { margin-top: 72px; padding-top: 28px; border-top: 1px solid var(--sf-rule); text-align: left; }
  [data-theme="simplefolio"] .sf-gh-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 18px; margin-bottom: 20px; }
  [data-theme="simplefolio"] .sf-gh-label { margin: 0; font-family: var(--sf-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sf-ash); }
  [data-theme="simplefolio"] .sf-gh-total { margin: 0; font-size: 15px; color: var(--sf-text); }
  [data-theme="simplefolio"] .sf-gh-total b { color: var(--sf-ink); font-weight: 600; }
  [data-theme="simplefolio"] .sf-gh-head .sf-cta--link { margin-left: auto; font-size: 14px; }
  /* Vertical padding gives the swelling cells room inside the scroll box, which clips */
  [data-theme="simplefolio"] .sf-gh-scroll { overflow-x: auto; padding: 18px 14px 22px; margin: -18px -14px -16px; direction: rtl; }
  [data-theme="simplefolio"] .sf-gh-chart { direction: ltr; --sf-gh-cell: 11px; --sf-gh-gap: 4px; min-width: max-content; }
  [data-theme="simplefolio"] .sf-gh-months,
  [data-theme="simplefolio"] .sf-gh-grid {
    /* Cells stretch to fill the width, but never shrink below --sf-gh-cell (then it scrolls) */
    display: grid; grid-template-columns: repeat(var(--sf-gh-weeks), minmax(var(--sf-gh-cell), 1fr)); column-gap: var(--sf-gh-gap);
  }
  [data-theme="simplefolio"] .sf-gh-months { margin-bottom: 8px; font-family: var(--sf-mono); font-size: 11px; color: var(--sf-muted); }
  /* Zero-width labels overflow their column so they never widen it */
  [data-theme="simplefolio"] .sf-gh-months span { grid-row: 1; width: 0; white-space: nowrap; overflow: visible; }
  [data-theme="simplefolio"] .sf-gh-grid { grid-template-rows: repeat(7, auto); row-gap: var(--sf-gh-gap); }
  [data-theme="simplefolio"] .sf-gh-grid { position: relative; }
  [data-theme="simplefolio"] .sf-gh-grid i { position: relative; aspect-ratio: 1; transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1); will-change: transform; }
  [data-theme="simplefolio"] .sf-gh i { display: block; border-radius: 2px; background: var(--sf-wash); outline: 1px solid color-mix(in srgb, var(--sf-ink) 4%, transparent); outline-offset: -1px; }
  [data-theme="simplefolio"] .sf-gh i[data-level="1"] { background: color-mix(in srgb, var(--sf-accent) 30%, var(--sf-wash)); }
  [data-theme="simplefolio"] .sf-gh i[data-level="2"] { background: color-mix(in srgb, var(--sf-accent) 55%, var(--sf-wash)); }
  [data-theme="simplefolio"] .sf-gh i[data-level="3"] { background: color-mix(in srgb, var(--sf-accent) 80%, var(--sf-wash)); }
  [data-theme="simplefolio"] .sf-gh i[data-level="4"] { background: var(--sf-accent); }
  [data-theme="simplefolio"] .sf-gh-legend { display: flex; align-items: center; justify-content: flex-end; gap: 4px; margin: 12px 0 0; font-family: var(--sf-mono); font-size: 11px; color: var(--sf-muted); }
  [data-theme="simplefolio"] .sf-gh-legend i { width: 11px; height: 11px; }
  [data-theme="simplefolio"] .sf-gh-legend i:first-child { margin-left: 4px; }
  [data-theme="simplefolio"] .sf-gh-legend i:last-child { margin-right: 4px; }

  /* Skills, certifications, education */
  [data-theme="simplefolio"] .sf-plain { color: var(--sf-ink); padding-bottom: 80px; }
  [data-theme="simplefolio"] .sf-plain--last { padding-bottom: 120px; }
  [data-theme="simplefolio"] .sf-plain--last .sf-project { margin-bottom: 0; }
  [data-theme="simplefolio"] .sf-cap-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 24px; text-align: left; }
  /* Six cards, three across */
  [data-theme="simplefolio"] .sf-cap { grid-column: span 2; display: flex; flex-direction: column; padding: 30px 28px 28px; }
  [data-theme="simplefolio"] .sf-cap-num { margin: 0 0 18px; font-family: var(--sf-mono); font-size: 0.72rem; letter-spacing: 0.12em; color: var(--sf-ash); }
  [data-theme="simplefolio"] .sf-cap-title { margin: 0 0 10px; font-size: 21px; font-weight: 700; letter-spacing: -0.03em; line-height: 1.2; color: var(--sf-ink); }
  [data-theme="simplefolio"] .sf-cap-claim { margin: 0 0 20px; font-size: 15px; line-height: 1.55; color: var(--sf-text); }
  [data-theme="simplefolio"] .sf-cap-proof { list-style: none; margin: auto 0 0; padding: 16px 0 0; border-top: 1px solid var(--sf-rule); }
  [data-theme="simplefolio"] .sf-cap-proof li { position: relative; padding-left: 16px; margin-bottom: 8px; font-size: 13px; line-height: 1.5; color: var(--sf-muted); }
  [data-theme="simplefolio"] .sf-cap-proof li:last-child { margin-bottom: 0; }
  [data-theme="simplefolio"] .sf-cap-proof li::before { content: ""; position: absolute; left: 0; top: 7px; width: 5px; height: 5px; background: var(--sf-accent); }
  [data-theme="simplefolio"] .sf-cert-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 40px; text-align: left; }
  [data-theme="simplefolio"] .sf-cert {
    display: grid; grid-template-columns: 44px minmax(0, 1fr); grid-auto-rows: auto; column-gap: 16px; row-gap: 3px; align-content: start;
    padding: 20px 0; border-bottom: 1px solid var(--sf-rule); min-width: 0;
  }
  [data-theme="simplefolio"] .sf-cert > :not(.sf-cert-logo) { grid-column: 2; }
  [data-theme="simplefolio"] .sf-cert-logo {
    grid-column: 1; grid-row: 1 / span 3; align-self: start; width: 44px; height: 44px; display: grid; place-items: center;
    border: 1px solid var(--sf-rule); border-radius: 4px; background: var(--sf-glass); color: var(--sf-ink);
  }
  [data-theme="simplefolio"] .sf-cert-logo svg { width: 22px; height: 22px; }
  [data-theme="simplefolio"] .sf-cert-logo img { width: 40px; height: 40px; object-fit: contain; }
  [data-theme="simplefolio"] .sf-cert-logo span { font-weight: 700; color: var(--sf-muted); }
  [data-theme="simplefolio"] .sf-cert-year { align-self: flex-start; font-family: var(--sf-mono); font-size: 13px; font-weight: 500; letter-spacing: 0.06em; line-height: 1.4; }
  [data-theme="simplefolio"] .sf-cert strong { font-size: 15px; line-height: 1.4; color: var(--sf-ink); }
  [data-theme="simplefolio"] .sf-cert-issuer { font-size: 13px; color: var(--sf-muted); }

  /* Contact */
  [data-theme="simplefolio"] .sf-contact { color: var(--sf-ink); padding: 40px 0 100px; }
  /* The card: HQ mark on the left (the logo lands here from the top bar), pitch and contact tiles on the right */
  [data-theme="simplefolio"] .sf-contact .sf-contact-card {
    display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 64px; align-items: center; padding: 64px; text-align: left; overflow: hidden;
  }
  [data-theme="simplefolio"] .sf-contact-card::before {
    content: ""; position: absolute; left: -120px; top: 50%; width: 560px; height: 560px; transform: translateY(-50%); pointer-events: none;
    background: radial-gradient(circle, color-mix(in srgb, var(--sf-primary) 20%, transparent), color-mix(in srgb, var(--sf-accent) 8%, transparent) 40%, transparent 68%);
  }
  [data-theme="simplefolio"] .sf-contact-mark { position: relative; width: 100%; }
  [data-theme="simplefolio"] .sf-contact-body { position: relative; min-width: 0; }
  [data-theme="simplefolio"] .sf-contact-body .sf-section-title { margin-bottom: 16px; text-align: left; }
  [data-theme="simplefolio"] .sf-contact-lede { max-width: 22ch; margin: 0 0 32px; font-size: 34px; font-weight: 700; line-height: 1.15; letter-spacing: -0.035em; color: var(--sf-ink); }
  [data-theme="simplefolio"] .sf-contact-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 0; padding: 0; list-style: none; }
  [data-theme="simplefolio"] .sf-contact-link {
    display: flex; align-items: center; gap: 14px; padding: 14px 16px; border: 1px solid var(--sf-rule);
    background: color-mix(in srgb, var(--sf-paper) 40%, transparent); color: var(--sf-ink); text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  [data-theme="simplefolio"] .sf-contact-link svg { flex: none; width: 20px; height: 20px; color: var(--sf-accent); }
  [data-theme="simplefolio"] .sf-contact-link span { display: flex; flex-direction: column; min-width: 0; font-size: 15px; overflow-wrap: anywhere; }
  [data-theme="simplefolio"] .sf-contact-link em { margin-bottom: 2px; font-style: normal; font-family: var(--sf-mono); font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sf-ash); }
  [data-theme="simplefolio"] .sf-contact-link b { margin-left: auto; font-weight: 400; color: var(--sf-ash); transition: transform 0.2s, color 0.2s; }
  [data-theme="simplefolio"] .sf-contact-link:hover { border-color: var(--sf-accent); background: color-mix(in srgb, var(--sf-accent) 8%, transparent); }
  [data-theme="simplefolio"] .sf-contact-link:hover b { color: var(--sf-accent); transform: translate(2px, -2px); }
  [data-theme="simplefolio"] .sf-contact-link:focus-visible { outline: 2px solid var(--sf-primary); outline-offset: 2px; }
  [data-theme="simplefolio"] .sf-contact-foot { margin: 22px 0 0; }
  [data-theme="simplefolio"] .sf-flags { font-size: 34px; letter-spacing: 0.12em; line-height: 1; }

  /* Footer */
  [data-theme="simplefolio"] .sf-footer { color: var(--sf-ink); padding: 32px 0 48px; }
  [data-theme="simplefolio"] .sf-back-to-top { display: inline-flex; color: var(--sf-ink); margin: 10px 0 16px; transition: all 0.2s ease-in; }
  [data-theme="simplefolio"] .sf-back-to-top:hover { transform: translateY(-2px); color: var(--sf-secondary); }
  [data-theme="simplefolio"] .sf-footer hr { margin: 20px auto 10px; border: 0; width: 50%; border-top: 1px solid var(--sf-rule); }
  [data-theme="simplefolio"] .sf-footer-text { color: var(--sf-muted); font-size: 13px; margin: 16px 0 0; }
  [data-theme="simplefolio"] .sf-footer-text a { color: var(--sf-muted); font-size: 13px; transition: all 0.4s; display: inline-block; }
  [data-theme="simplefolio"] .sf-footer-text a:hover { color: var(--sf-secondary); }

  /* Responsive (template breakpoints: 1200 / 900 / 768 / 600 / 320) */
  @media (max-width: 1200px) {
    [data-theme="simplefolio"] .sf-hero-title { font-size: 40px; }
    [data-theme="simplefolio"] .sf-project-image { width: 100%; margin: 0; }
    [data-theme="simplefolio"] .sf-plain--last { padding-bottom: 80px; }
    [data-theme="simplefolio"] .sf-cap-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    [data-theme="simplefolio"] .sf-cap { grid-column: auto; }
  }
  @media (max-width: 991.98px) {
    [data-theme="simplefolio"] .sf-project-text { margin-bottom: 48px; }
    [data-theme="simplefolio"] .sf-cert-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    [data-theme="simplefolio"] .sf-panel { padding: 48px 32px; }
    [data-theme="simplefolio"] .sf-proj-grid { grid-template-columns: minmax(0, 1fr); }
    [data-theme="simplefolio"] .sf-posts { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    [data-theme="simplefolio"] .sf-proj:only-child { display: block; }
    [data-theme="simplefolio"] .sf-proj:only-child .sf-shot { margin-bottom: 24px; }
    [data-theme="simplefolio"] .sf-gh-chart { --sf-gh-gap: 3px; }
  }
  @media (max-width: 1100px) { [data-theme="simplefolio"] .sf-hero-mark { width: 220px; } }
  @media (max-width: 900px) {
    [data-theme="simplefolio"] .sf-topbar-slot { width: 52px; }
    [data-theme="simplefolio"] .sf-hero-inner { flex-direction: column; gap: 28px; }
    [data-theme="simplefolio"] .sf-hero-mark { width: 180px; }
    [data-theme="simplefolio"] .sf-topbar-name { font-size: 15px; }
    [data-theme="simplefolio"] .sf-topbar { justify-content: flex-start; padding-left: 12px; height: 68px; }
    [data-theme="simplefolio"] .sf-topbar-sec { display: none; }
    [data-theme="simplefolio"] .sf-hero-title { font-size: 36px; text-align: center; }
  }
  @media (max-width: 768px) {
    [data-theme="simplefolio"] .sf-about-image { padding-bottom: 48px; }
    [data-theme="simplefolio"] .sf-about-info { align-items: center; text-align: center; }
    [data-theme="simplefolio"] .sf-about-list { text-align: left; }
    [data-theme="simplefolio"] .sf-about-actions { justify-content: center; }
    [data-theme="simplefolio"] .sf-shot-body { padding: 24px; }
    [data-theme="simplefolio"] .sf-shot-name { font-size: 28px; }
    [data-theme="simplefolio"] .sf-shot-initial { font-size: 180px; }
  }
  @media (max-width: 600px) {
    [data-theme="simplefolio"] section { padding-left: 4px; padding-right: 4px; }
    [data-theme="simplefolio"] .sf-hero { padding: 0 16px; }
    [data-theme="simplefolio"] .sf-section-title { font-size: 28px; margin-bottom: 32px; }

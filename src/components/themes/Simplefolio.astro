---
// Layout modelled on cobiwave/simplefolio (full-screen hero, project rows with
// tilt-and-glare thumbnails), dressed in the FlowSense app's design language:
// neutral paper/wash/rule roles with the in/out flow colours as primary (blue) and accent (green),
// dot ground, frosted panels, Inter + Roboto Mono, 4px corners.
// Dark by default; light is a toggle that persists in localStorage ("sf-mode").
import { resume, rfc1925Truths } from "../../data/resume";
import {
  skillCategories,
  certifications,
  education,
  experienceByCompany,
  countries,
  stats,
  summaryText,
  githubUrl,
  companySites,
  twitterHandle,
  ghWeeks,
  ghTotal,
  ghMonthLabels,
  hasContributions,
} from "../../data/derive";
import anthropicLogo from "../../assets/logos/anthropic.svg?raw";
import udemyLogo from "../../assets/logos/udemy.svg?raw";
import hashicorpLogo from "../../assets/logos/hashicorp.svg?raw";
import edxLogo from "../../assets/logos/edx.svg?raw";
import awsLogo from "../../assets/logos/amazonwebservices.svg?raw";
import posts from "../../data/posts.json";
import hqLogo from "../../data/hq-logo.json";

const firstYear = (s: string) => s.match(/\d{4}/)?.[0] ?? "";

// Issuer logos: Simple Icons (CC0) drawn in the text colour; Stanford's Block S
// is a raster from identity.stanford.edu and keeps its own colours.
const issuerLogos: Record<string, { svg?: string; img?: string }> = {
  Anthropic: { svg: anthropicLogo },
  Udemy: { svg: udemyLogo },
  HashiCorp: { svg: hashicorpLogo },
  edX: { svg: edxLogo },
  "Amazon Web Services (AWS)": { svg: awsLogo },
  "Stanford University": { img: "/logos/stanford.png" },
};

const companies = experienceByCompany.map((group, index) => {
  const newest = group.roles[0];
  const oldest = group.roles[group.roles.length - 1];
  const start = oldest.period.split(" - ")[0] ?? "";
  const end = newest.period.split(" - ")[1] ?? "";
  const startYear = firstYear(start);
  const endYear = end === "Present" ? "Present" : firstYear(end);
  return {
    ...group,
    id: `sf-job-${index}`,
    range: `${start} – ${end}`,
    years: startYear === endYear ? startYear : `${startYear} — ${endYear}`,
    location: newest.location,
    highlights: group.roles.reduce((n, r) => n + r.bullets.length, 0),
    lead: newest.bullets.slice(0, 2),
    initial: group.company.charAt(0),
    tone: ["teal", "navy", "light"][index % 3],
    site: companySites[group.company] ?? { label: group.company },
  };
});

const socials = [
  { label: "X (Twitter)", href: resume.twitter, path: "M18.9 1.2h3.7l-8 9.2L24 22.8h-7.4l-5.8-7.6-6.6 7.6H.5l8.6-9.8L0 1.2h7.6l5.2 6.9 6.1-6.9Zm-1.3 19.4h2L6.5 3.2H4.3l13.3 17.4Z" },
  { label: "LinkedIn", href: resume.linkedin, path: "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" },
  { label: "GitHub", href: githubUrl, path: "M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-1.96c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" },
];

// ArkaType's product and the open-source work, shown as website windows; each
// opens the shared browser dialog.
const products = [
  {
    id: "sf-proj-flowsense",
    name: "FlowSense.AI",
    kicker: "ArkaType Intelligence · macOS",
    tagline: "Agentic cyber intelligence. Every flow, identified in real time.",
    when: "Launching 2026",
    where: "macOS app by ArkaType Intelligence",
    site: { label: "getflowsense.com", image: "/sites/flowsense.jpg", tag: "launching soon" },
    role: "ArkaType Intelligence's first product",
    summary: "A Mac app that names every network flow, lets you write rules for them in FlowRuby or hand them to your agents, and explains what changed in plain English, all on-device.",
    bullets: [
      "Names every flow in real time with a carrier-grade packet intelligence engine: 1,400+ signatures, TLS and QUIC included, reading a passive copy of the interface without decrypting anything, at about 16% of one core at 1 GbE line rate.",
      "Live view of the last sixty seconds, then a tree of application, app, hostname and flow with up and down rates, trend, flow count and round-trip time, plus process attribution where macOS allows it.",
      "A daily briefing instead of a dashboard, written on the Mac by Apple Intelligence or a local model in one of seven personas, with follow-up questions by chat or voice.",
      "FlowRuby, a language for policies and custom signatures: scope rules by app, device or destination, set schedules and expiring rules, and recognize your own services from hostnames or packet contents, written by hand or by agents.",
      "Auto mode: a typed decision model blocks, shapes or prioritizes traffic on its own, and every action lands in an undoable journal with its reason and the rule it wrote. Off by default.",
    ],
  },
];

const openSource = [
  {
    id: "sf-proj-qstack",
    name: "qstack",
    kicker: "Open source · MIT",
    tagline: "Agent skills for reviewable planning, disciplined execution and durable lessons.",
    when: "2026",
    where: "GitHub · Claude Code, Codex",
    site: { label: "github.com/hani-q/qstack", url: "https://github.com/hani-q/qstack", image: "/sites/qstack.jpg", tag: "open source" },
    role: "Author and maintainer",
    summary: "A personal stack of 33 agent skills for Claude Code and Codex that turn plans into reviewable documents, execute them without drift, and keep the lessons.",
    bullets: [
      "33 skills for Claude Code, Codex and any harness that reads ~/.agents/skills, installed from one checkout that stays the source of truth, and published on skills.sh.",
      "Turns a Markdown draft or a chat into a numbered HTML plan, with a high-level half for whoever approves the work and a low-level half for the agent, so review feedback can cite clauses like §4.2.",
      "Execution loops work the plan card by card, keep a running execution.md and ask how much adversarial review to run; an adherence review then scores the outcome from 0 to 5 against the plan, the record and the diff.",
      "A review skill scores code against a correctness baseline plus the repository's CODE_REVIEW_RULES.md, and plan-close and prior-art skills carry what work actually cost into the next plan instead of growing AGENTS.md.",
      "Ten engineering-practice skills adapted from Lauren Tan's PStack: diagnose before patching, prove the real artifact runs, separate ownership before reaching for a lock.",
    ],
  },
];

// Contribution levels by quartile of active days, so a busy year still shows contrast.
const ghActive = ghWeeks.flatMap((w) => w.contributionDays.map((d) => d.contributionCount)).filter((n) => n > 0).sort((a, b) => a - b);
const ghQuart = [0.25, 0.5, 0.75].map((q) => ghActive[Math.floor(q * (ghActive.length - 1))] ?? 0);
const ghCellLevel = (n: number) => (n === 0 ? 0 : n <= ghQuart[0] ? 1 : n <= ghQuart[1] ? 2 : n <= ghQuart[2] ? 3 : 4);

// Hero second line rotates through these, as the old portal's headline did.
const heroLines = [
  "Founder of ArkaType Intelligence.",
  "Building agentic cyber intelligence.",
  "Every flow, explained.",
  "From Packets to Products.",
  `${resume.yearsOfExperience}+ Years of Shipping.`,
  "Engineering the Next Engineering.",
  "Build. Lead. Ship.",
];

// Capabilities shown on the site in place of tool lists (the printed résumé keeps the
// full tool keywords for ATS). Each claim is backed only by facts in the record.
const capabilities = [
  {
    title: "Agentic engineering leadership",
    claim: "Runs engineering through specifications, agent implementation, and governed review.",
    proof: [
      "DNI: engineering run agentic-first across five teams",
      "ArkaType: FlowSense.AI built agentic-first",
      "qstack: 33 open-source agent skills for planning, execution and review",
    ],
  },
  {
    title: "Network & packet intelligence",
    claim: "Builds traffic-classification systems spanning carrier-scale DPI, applied ML, and on-device intelligence.",
    proof: [
      "Sandvine: DPI, PCRF and NFV for operators serving 30M+ subscribers",
      "Led the Traffic Classification Centre of Excellence; ML models at 95% accuracy on encrypted applications",
      "FlowSense.AI: on-device classification of encrypted traffic (pre-launch)",
    ],
  },
  {
    title: "Engineering organization building",
    claim: "Builds engineering teams from zero, including a 20+ person organization across five teams.",
    proof: [
      "DNI: org structure, team charters and hiring from a greenfield start",
      "Sandvine: led a five-engineer Centre of Excellence",
      "Founded Vincere Systems and ArkaType Intelligence",
    ],
  },
  {
    title: "Technical product leadership",
    claim: "Owns DPI product direction and is developing FlowSense.AI, a pre-launch cyber-intelligence product.",
    proof: [
      "DNI: product management across the full DPI stack",
      "DNI: FCAPS, analytics and deployment products",
      "ArkaType: building FlowSense.AI from zero toward launch",
    ],
  },
  {
    title: "Network & platform architecture",
    claim: "Designs programmable network infrastructure and the automation that deploys it.",
    proof: [
      "PLUMgrid: SDN, VXLAN/VTEP overlays and microsegmentation for OpenStack",
      "DNI: DevSecOps, GitOps and infrastructure as code",
      "AWS Solutions Architect Professional, Terraform Associate",
    ],
  },
];

const highlights = resume.overview.highlights.slice(0, 4);
const truth = rfc1925Truths.find((t) => t.number === "12") ?? rfc1925Truths[0];
const year = new Date().getFullYear();
const tiltAttrs = { "data-sf-tilt": "" };
---

<div data-theme="simplefolio" data-mode="dark" class="sf-root" id="sf-top" data-cv-title={`${resume.name} - Resume`}>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script is:inline>
    (function () {
      var root = document.querySelector('[data-theme="simplefolio"]');
      if (!root) return;
      try { if (localStorage.getItem('sf-mode') === 'light') root.setAttribute('data-mode', 'light'); } catch (e) {}
    })();
  </script>

  <div class="sf-ambient" aria-hidden="true"></div>

  <header class="sf-topbar" aria-hidden="true">
    <span class="sf-topbar-slot" style={`aspect-ratio: ${hqLogo.viewBox[2]} / ${hqLogo.viewBox[3]}`}></span>
    <span class="sf-topbar-id">
      <span class="sf-topbar-name">{resume.name}</span>
      <span class="sf-topbar-sec" data-sf-sec><span class="sf-topbar-sep"></span><span class="sf-topbar-roll"></span></span>
    </span>
  </header>
  <a class="sf-brand" href="#sf-top" aria-label={`${resume.name}, back to top`} data-hq-palettes={JSON.stringify(hqLogo.palettes)} data-hq-favicons={JSON.stringify(hqLogo.favicons)}>
    <svg viewBox={hqLogo.viewBox.join(" ")} aria-hidden="true" set:html={hqLogo.logo} />
  </a>
  <div class="sf-tools">
  <button type="button" class="sf-mode sf-print" aria-label="Print or save résumé as PDF" title="Print résumé (PDF)">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6" /><rect x="3" y="9" width="18" height="8" rx="1" /><path d="M6 14h12v7H6z" /></svg>
  </button>
  <button type="button" class="sf-mode" id="sf-mode" aria-label="Switch to light mode" aria-pressed="false">
    <svg class="sf-mode-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" /></svg>
    <svg class="sf-mode-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7Z" /></svg>
  </button>
  </div>

  <!-- Print-only résumé: plain single column with standard headings so ATS parsers read it cleanly -->
  <article class="sf-cv" aria-hidden="true">
    <header>
      <h1>{resume.name}</h1>
      <p class="sf-cv-title">{resume.title}</p>
      <p class="sf-cv-contact">
        {resume.location} | {resume.phone} | {resume.email}<br />
        {resume.linkedin.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "")} | {githubUrl.replace(/^https?:\/\//, "")}
      </p>
    </header>
    <section>
      <h2>Professional Summary</h2>
      <p>{summaryText}</p>
      <ul>{resume.overview.highlights.map((h) => <li>{h}</li>)}</ul>
    </section>
    <section>
      <h2>Professional Experience</h2>
      {resume.experience.map((job) => (
        <div class="sf-cv-job">
          <h3>{job.title}</h3>
          <p class="sf-cv-meta">{job.company} | {job.location} | {job.period}</p>
          <ul>{job.bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
      ))}
    </section>
    <section>
      <h2>Products and Open Source</h2>
      {[...products, ...openSource].map((pr) => (
        <div class="sf-cv-job">
          <h3>{pr.name}</h3>
          <p class="sf-cv-meta">{pr.role} | {pr.where} | {pr.site.url ? pr.site.url.replace(/^https?:\/\//, "") : pr.site.label}</p>
          <p>{pr.summary}</p>
        </div>
      ))}
    </section>
    <section>
      <h2>Skills</h2>
      {skillCategories.map((cat) => <p class="sf-cv-skill"><strong>{cat.label}:</strong> {cat.items.join(", ")}</p>)}
    </section>
    <section>
      <h2>Certifications</h2>
      <ul>{certifications.map((c) => <li>{c.name}, {c.issuer} ({c.year})</li>)}</ul>
    </section>
    <section>
      <h2>Education</h2>
      <p><strong>{education.degree} (Major: {education.major})</strong><br />{education.school}, {education.location} | {education.year}</p>
    </section>
    <section>
      <h2>Volunteer Experience</h2>
      <p><strong>{resume.involvement.role}</strong>, {resume.involvement.organization} | {resume.involvement.period}</p>
    </section>
  </article>

  <!-- Hero -->
  <section class="sf-hero" id="sf-hero">
    <div class="sf-container sf-hero-inner">
      <div class="sf-hero-copy">
      <h1 class="sf-hero-title">
        Hi, my name is <span class="sf-grad sf-hero-name">{resume.name}</span>
        <br />
        <span class="sf-rotator" data-sf-rotator>
          {heroLines.map((line, i) => <span class:list={["sf-rotator-line", { "sf-rotator-line--on": i === 0 }]} aria-hidden={i === 0 ? undefined : "true"}>{line}</span>)}
        </span>
      </h1>
      <p class="sf-hero-cta">
        <a class="sf-cta sf-cta--hero" href="#sf-about">Know more</a>
      </p>
      </div>
      <div class="sf-hero-mark" aria-hidden="true" style={`aspect-ratio: ${hqLogo.viewBox[2]} / ${hqLogo.viewBox[3]}`}></div>
    </div>
  </section>

  <!-- About -->
  <section class="sf-about" id="sf-about">
    <div class="sf-container">
      <h2 class="sf-section-title">About me</h2>
      <div class="sf-row sf-about-wrapper">
        <div class="sf-col-md-6">
          <div class="sf-about-image">
            <img src={resume.profileImage} alt={`Portrait of ${resume.name}`} width="340" height="340" loading="eager" />
          </div>
        </div>
        <div class="sf-col-md-6">
          <div class="sf-about-info">
            <p class="sf-about-text">{summaryText}</p>
            <p class="sf-about-text">
              {stats.years}+ years, <span class="sf-important">{stats.companies} companies</span> and
              <span class="sf-important">{stats.countries} countries</span> ({countries.join(", ")}), from startups to telecom operators serving millions of subscribers.
            </p>
            <ul class="sf-about-list">
              {highlights.map((h) => <li>{h}</li>)}
            </ul>
            <span class="sf-about-actions">
              <button type="button" class="sf-cta sf-cta--resume sf-icon-btn sf-print" aria-label="View résumé (print or save as PDF)" title="Résumé">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></svg>
              </button>
              {["LinkedIn", "X (Twitter)"].map((l) => socials.find((s) => s.label === l)!).map((s) => (
                <a class="sf-cta sf-cta--resume sf-icon-btn" href={s.href} target="_blank" rel="noreferrer" aria-label={s.label} title={s.label}>
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
                </a>
              ))}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Products: what ArkaType ships -->
  <section class="sf-plain" id="sf-products">
    <div class="sf-container">
      <h2 class="sf-section-title sf-dark">Products</h2>
      {products.map((pr) => (
        <div class="sf-row sf-project">
          <div class="sf-col-lg-4">
            <div class="sf-project-text">
              <h3 class="sf-project-title">{pr.name}</h3>
              <p class="sf-project-meta"><span class="sf-grad">{pr.when}</span> · {pr.where}</p>
              <p class="sf-project-lead">{pr.summary}</p>
              <div class="sf-project-actions">
                <button type="button" class="sf-cta sf-cta--hero" data-sf-open={pr.id}>Open product</button>
                <a class="sf-cta sf-grad sf-cta--link" href="https://www.arka-type.com/" target="_blank" rel="noreferrer">ArkaType ↗</a>
              </div>
            </div>
          </div>
          <div class="sf-col-lg-8">
            <div class="sf-project-image">
              <button type="button" class="sf-shot-link" data-sf-open={pr.id} aria-label={`Open ${pr.site.label} and the ${pr.name} details`}>
                <div class="sf-thumbnail sf-shot" {...tiltAttrs} data-sf-window={pr.id}>
                  <div class="sf-shot-bar" aria-hidden="true">
                    <i></i><i></i><i></i>
                    <span class="sf-url">{pr.site.label}</span>
                    <em class="sf-url-tag">{pr.site.tag}</em>
                    <span class="sf-expand">Expand ↗</span>
                  </div>
                  <div class="sf-site" aria-hidden="true">
                    <img src={pr.site.image} alt="" loading="lazy" decoding="async" width="1440" height="4200" />
                    <div class="sf-site-caption">
                      <span class="sf-shot-years">{pr.kicker}</span>
                      <span class="sf-site-role">{pr.tagline}</span>
                    </div>
                  </div>
                </div>
              </button>
            </div>
          </div>
          <div class="sf-col-12">
            <div class="sf-details" id={`${pr.id}-details`} data-kind="Product" data-company={pr.name} data-range={pr.when} data-location={pr.where}
              data-site-label={pr.site.label} data-site-image={pr.site.image} data-site-tag={pr.site.tag}>
              <div class="sf-details-inner">
                <article class="sf-detail-role">
                  <h4>{pr.role}</h4>
                  <p class="sf-detail-meta">{pr.where}</p>
                  <ul>{pr.bullets.map((b) => <li>{b}</li>)}</ul>
                </article>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Experience (the template's "Projects") -->
  <section class="sf-projects" id="sf-experience">
    <div class="sf-container">
      <div class="sf-project-wrapper">
        <h2 class="sf-section-title sf-dark">Experience</h2>

        {companies.map((c, i) => (
          <div class="sf-row sf-project" id={c.id}>
            <div class="sf-col-lg-4">
              <div class="sf-project-text">
                <h3 class="sf-project-title">{c.company}</h3>
                <p class="sf-project-meta"><span class="sf-grad">{c.range}</span> · {c.location}</p>
                <ul class="sf-project-roles">
                  {c.roles.map((r) => <li><strong>{r.title}</strong><span>{r.period}</span></li>)}
                </ul>
                <p class="sf-project-lead">{c.lead[0]}</p>
                <div class="sf-project-actions">
                  <button type="button" class="sf-cta sf-cta--hero" data-sf-open={c.id}>Open experience</button>
                  <a class="sf-cta sf-grad sf-cta--link" href={i < companies.length - 1 ? `#${companies[i + 1].id}` : "#sf-skills"}>
                    {i < companies.length - 1 ? "Next role" : "Skills"}
                  </a>
                </div>
              </div>
            </div>
            <div class="sf-col-lg-8">
              <div class="sf-project-image">
                <button type="button" class="sf-shot-link" data-sf-open={c.id} aria-label={`Open ${c.site.label} and the ${c.company} experience`}>
                  <div class={`sf-thumbnail sf-shot sf-shot--${c.tone}`} {...tiltAttrs} data-sf-window={c.id}>
                    <div class="sf-shot-bar" aria-hidden="true">
                      <i></i><i></i><i></i>
                      <span class="sf-url">{c.site.label}</span>
                      {c.site.archived && <em class="sf-url-tag">archived {c.site.archived}</em>}
                      {!c.site.image && <em class="sf-url-tag">offline</em>}
                      <span class="sf-expand">Expand ↗</span>
                    </div>
                    {c.site.image ? (
                      <div class="sf-site" aria-hidden="true">
                        <img src={c.site.image} alt="" loading="lazy" decoding="async" width="1440" height="4200" />
                        <div class="sf-site-caption">
                          <span class="sf-shot-years">{c.years}</span>
                          <span class="sf-site-role">{c.roles[0].title}</span>
                        </div>
                      </div>

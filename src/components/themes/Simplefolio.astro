  <script is:inline>
    (function () {
      var root = document.querySelector('[data-theme="simplefolio"]');
      if (!root) return;
      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Appearance: dark by default, light persists once chosen.
      var modeBtn = document.getElementById('sf-mode');
      function syncMode() {
        var light = root.getAttribute('data-mode') === 'light';
        modeBtn.setAttribute('aria-pressed', String(light));
        modeBtn.setAttribute('aria-label', light ? 'Switch to dark mode' : 'Switch to light mode');
      }
      if (modeBtn) {
        syncMode();
        modeBtn.addEventListener('click', function () {
          var next = root.getAttribute('data-mode') === 'light' ? 'dark' : 'light';
          root.setAttribute('data-mode', next);
          try { localStorage.setItem('sf-mode', next); } catch (e) {}
          syncMode();
        });
      }

      // Tilt with glare (stands in for vanilla-tilt: max 4deg, glare 0.5).
      var fine = window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (fine && !reduced) {
        Array.prototype.forEach.call(root.querySelectorAll('[data-sf-tilt]'), function (el) {
          var max = 4, glareMax = root.getAttribute('data-mode') === 'light' ? 0.5 : 0.18, raf = 0;
          var wrap = document.createElement('div');
          wrap.className = 'sf-glare-wrap';
          wrap.setAttribute('aria-hidden', 'true');
          var glare = document.createElement('div');
          glare.className = 'sf-glare';
          wrap.appendChild(glare);
          el.appendChild(wrap);
          el.addEventListener('mouseenter', function () { el.classList.add('sf-tilting'); });
          el.addEventListener('mousemove', function (e) {
            if (raf) cancelAnimationFrame(raf);
            raf = requestAnimationFrame(function () {
              var r = el.getBoundingClientRect();
              var px = Math.min(Math.max((e.clientX - r.left) / r.width, 0), 1);
              var py = Math.min(Math.max((e.clientY - r.top) / r.height, 0), 1);
              var tiltX = (max / 2 - px * max).toFixed(2);
              var tiltY = (py * max - max / 2).toFixed(2);
              var angle = Math.atan2(e.clientX - (r.left + r.width / 2), -(e.clientY - (r.top + r.height / 2))) * (180 / Math.PI);
              el.style.transform = 'perspective(1000px) rotateX(' + tiltY + 'deg) rotateY(' + tiltX + 'deg) scale3d(1,1,1)';
              glare.style.transform = 'rotate(' + angle + 'deg) translate(-50%, -50%)';
              glare.style.opacity = String(py * glareMax);
            });
          });
          el.addEventListener('mouseleave', function () {
            if (raf) cancelAnimationFrame(raf);
            el.classList.remove('sf-tilting');
            el.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
            glare.style.opacity = '0';
          });
        });
      }

      // HQ mark position: large beside the hero text at the top, flies into the top bar as
      // the page scrolls (progress over the first 45% of a screen), where it sits next to
      // the name. Positions are measured from the two placeholder boxes, so layout owns them.
      var markEl = root.querySelector('.sf-brand');
      var heroSpot = root.querySelector('.sf-hero-mark');
      var barSpot = root.querySelector('.sf-topbar-slot');
      var topbar = root.querySelector('.sf-topbar');
      if (markEl && heroSpot && barSpot && topbar) {
        var markTick = false;
        function placeMark() {
          markTick = false;
          var raw = Math.min(Math.max(window.scrollY / (window.innerHeight * 0.45), 0), 1);
          var t = reduced ? (raw > 0.5 ? 1 : 0) : raw * raw * (3 - 2 * raw);   // smoothstep
          var a = heroSpot.getBoundingClientRect(), b = barSpot.getBoundingClientRect();
          // Both placeholders are measured live: the hero one scrolls away as the mark travels.
          var x = a.left + (b.left - a.left) * t, y = a.top + (b.top - a.top) * t;
          var w = a.width + (b.width - a.width) * t;
          markEl.style.transform = 'translate(' + x.toFixed(1) + 'px,' + y.toFixed(1) + 'px)';
          markEl.style.width = w.toFixed(1) + 'px';
          // The name doesn't travel: it fades out of the hero as the bar name fades in.
          var heroName = root.querySelector('.sf-hero-name');
          if (heroName) heroName.style.opacity = Math.max(0, 1 - t * 2.2).toFixed(3);
          topbar.style.setProperty('--sf-bar', t.toFixed(3));
          root.classList.toggle('sf-docked', t >= 0.999);
        }
        function queueMark() { if (!markTick) { markTick = true; requestAnimationFrame(placeMark); } }
        window.addEventListener('scroll', queueMark, { passive: true });
        window.addEventListener('resize', queueMark);
        window.addEventListener('load', queueMark);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(queueMark);
        placeMark();
      }

      // HQ mark: step through every palette (logo colours via CSS variables, favicon via
      // a data: URI per palette). Light mode uses the darkened set. Every 5s; paused when
      // hidden; reduced motion stays on the first palette.
      var brand = root.querySelector('.sf-brand');
      if (brand) {
        var pals = JSON.parse(brand.getAttribute('data-hq-palettes') || '[]');
        var favs = JSON.parse(brand.getAttribute('data-hq-favicons') || '[]');
        var icon = document.querySelector('link[rel="icon"]');
        if (!icon) { icon = document.createElement('link'); icon.rel = 'icon'; document.head.appendChild(icon); }
        icon.type = 'image/svg+xml';
        var palIdx = 0;
        function paint() {
          var set = pals[palIdx][root.getAttribute('data-mode') === 'light' ? 'light' : 'dark'];
          ['h', 'q', 'hd', 'qd'].forEach(function (key) {
            if (set[key]) brand.style.setProperty('--hq-' + key, set[key]); else brand.style.removeProperty('--hq-' + key);
          });
          // The page accents follow the mark: primary takes the H colour, accent the Q colour
          // (falling back to the dot colours, then to the theme's own blue and green).
          var prim = set.h || set.hd, acc = set.q || set.qd;
          if (prim) root.style.setProperty('--sf-primary', prim); else root.style.removeProperty('--sf-primary');
          if (acc) root.style.setProperty('--sf-accent', acc); else root.style.removeProperty('--sf-accent');
          brand.title = pals[palIdx].name;
          if (favs[palIdx]) icon.href = favs[palIdx];
        }
        paint();
        new MutationObserver(paint).observe(root, { attributes: true, attributeFilter: ['data-mode'] });
        if (!reduced && pals.length > 1) setInterval(function () { if (document.hidden) return; palIdx = (palIdx + 1) % pals.length; paint(); }, 5000);
      }

      // Hero headline: rotate the second line every 6s; every line shares one grid

  [data-theme="simplefolio"] .sf-site { position: relative; flex: 1; min-height: 0; overflow: hidden; background: var(--sf-display); }
  [data-theme="simplefolio"] .sf-site img { display: block; width: 100%; height: auto; transform: translateY(0); transition: transform 2.4s cubic-bezier(0.45, 0, 0.2, 1); }

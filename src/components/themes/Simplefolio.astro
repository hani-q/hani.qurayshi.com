  [data-theme="simplefolio"] .sf-about-image { display: flex; height: 100%; align-items: center; justify-content: center; }
  [data-theme="simplefolio"] .sf-about-image img {
    width: 340px; max-width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; object-position: center 12%;
    border-radius: 4px; border: 1px solid var(--sf-rule);
    box-shadow: var(--sf-shadow);
  }
  [data-theme="simplefolio"] .sf-about-info { display: flex; height: 100%; justify-content: center; flex-direction: column; text-align: left; }
  [data-theme="simplefolio"] .sf-important { background: var(--sf-tag); color: var(--sf-tag-ink); display: inline-block; font-weight: 600; padding: 0 5px; margin: 3px 0; border-radius: 2px; line-height: 1.6; }
  [data-theme="simplefolio"] .sf-about-list { list-style: none; margin: 0 0 8px; padding: 0; }
  [data-theme="simplefolio"] .sf-about-list li { position: relative; padding-left: 20px; margin-bottom: 8px; font-size: 14px; line-height: 1.55; }
  [data-theme="simplefolio"] .sf-about-list li::before { content: ""; position: absolute; left: 2px; top: 8px; width: 7px; height: 7px; border: 2px solid var(--sf-secondary); transform: rotate(45deg); }
  [data-theme="simplefolio"] .sf-about-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 16px; }
  [data-theme="simplefolio"] .sf-about-actions .sf-cta { font-size: 15px; }
  [data-theme="simplefolio"] .sf-icon-btn { width: 46px; height: 46px; padding: 0; justify-content: center; }
  [data-theme="simplefolio"] .sf-icon-btn svg { position: relative; flex: none; }

  /* Projects → experience */
  [data-theme="simplefolio"] .sf-projects { color: var(--sf-ink); padding-top: 60px; }
  [data-theme="simplefolio"] .sf-project-wrapper { margin-bottom: 70px; }
  [data-theme="simplefolio"] .sf-project { margin-bottom: 80px; scroll-margin-top: 40px; }
  [data-theme="simplefolio"] .sf-project-text { text-align: left; }
  [data-theme="simplefolio"] .sf-project-title { font-weight: 700; margin: 0 0 10px; font-size: 26px; letter-spacing: -0.03em; line-height: 1.15; overflow-wrap: anywhere; color: var(--sf-ink); }
  [data-theme="simplefolio"] .sf-project-meta { font-family: var(--sf-mono); font-size: 12px; font-weight: 400; letter-spacing: 0.02em; margin-bottom: 16px; color: var(--sf-muted); }
  [data-theme="simplefolio"] .sf-project-roles { list-style: none; margin: 0 0 14px; padding: 0 0 0 12px; border-left: 2px solid var(--sf-accent); }
  [data-theme="simplefolio"] .sf-project-roles li { display: flex; flex-direction: column; margin-bottom: 8px; font-size: 14px; line-height: 1.4; color: var(--sf-ink); }
  [data-theme="simplefolio"] .sf-project-roles span { font-family: var(--sf-mono); font-size: 11.5px; color: var(--sf-muted); }
  [data-theme="simplefolio"] .sf-project-lead { margin-bottom: 24px; font-size: 15px; color: var(--sf-text); }
  [data-theme="simplefolio"] .sf-project-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  [data-theme="simplefolio"] .sf-project-actions .sf-cta { font-size: 15px; }
  [data-theme="simplefolio"] .sf-project-image { width: 90%; margin: 0 auto; }
  [data-theme="simplefolio"] .sf-shot-link { display: block; }
  [data-theme="simplefolio"] .sf-thumbnail {
    position: relative;
    transition: 0.5s transform cubic-bezier(0.155, 1.105, 0.295, 1.12), 0.5s box-shadow, 0.4s border-color;
    transform-style: preserve-3d; will-change: transform;
  }
  [data-theme="simplefolio"] .sf-thumbnail:hover { border-color: var(--sf-ash); }
  [data-theme="simplefolio"] .sf-thumbnail.sf-tilting { transition: box-shadow 0.5s, border-color 0.4s, transform 0.3s cubic-bezier(0.03, 0.98, 0.52, 0.99); }
  [data-theme="simplefolio"] .sf-glare-wrap { position: absolute; inset: 0; overflow: hidden; pointer-events: none; border-radius: inherit; z-index: 3; }
  [data-theme="simplefolio"] .sf-glare {
    position: absolute; top: 50%; left: 50%; width: 200%; height: 200%; pointer-events: none; opacity: 0;
    background-image: linear-gradient(0deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 1) 100%);
    transform: rotate(180deg) translate(-50%, -50%); transform-origin: 0 0; transition: opacity 0.3s;
  }

  /* Faux project screenshot, as a glass window */
  [data-theme="simplefolio"] .sf-shot { overflow: hidden; display: flex; flex-direction: column; aspect-ratio: 16 / 10; text-align: left; }
  [data-theme="simplefolio"] .sf-shot-bar { display: flex; align-items: center; gap: 6px; height: 34px; padding: 0 14px; background: var(--sf-glass); border-bottom: 1px solid var(--sf-rule); flex: none; }
  [data-theme="simplefolio"] .sf-shot-bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--sf-rule); }
  [data-theme="simplefolio"] .sf-shot-bar i:first-child { background: #ff6159; }
  [data-theme="simplefolio"] .sf-shot-bar i:nth-child(2) { background: #ffbd2e; }
  [data-theme="simplefolio"] .sf-shot-bar i:nth-child(3) { background: #28c941; }
  [data-theme="simplefolio"] .sf-shot-bar span { margin-left: 12px; padding: 3px 14px; background: var(--sf-glass-strong); border: 1px solid var(--sf-rule); border-radius: 2px; font-family: var(--sf-mono); font-size: 11px; color: var(--sf-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  [data-theme="simplefolio"] .sf-shot-body { position: relative; flex: 1; display: flex; flex-direction: column; justify-content: flex-end; gap: 10px; padding: 36px 40px; overflow: hidden; color: var(--sf-ink); }
  [data-theme="simplefolio"] .sf-shot-initial { position: absolute; right: -10px; top: -40px; font-size: 260px; font-weight: 700; line-height: 1; opacity: 0.1; pointer-events: none; color: var(--sf-ink); }
  [data-theme="simplefolio"] .sf-shot-years { font-family: var(--sf-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sf-ash); }
  [data-theme="simplefolio"] .sf-shot-name { position: relative; font-size: 38px; font-weight: 700; letter-spacing: -0.04em; line-height: 1.05; overflow-wrap: anywhere; }
  [data-theme="simplefolio"] .sf-shot-role { position: relative; font-size: 15px; max-width: 34em; color: var(--sf-text); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  [data-theme="simplefolio"] .sf-shot-stats { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  [data-theme="simplefolio"] .sf-shot-stats > span { padding: 5px 10px; font-family: var(--sf-mono); font-size: 11.5px; border-radius: 2px; background: var(--sf-glass-strong); border: 1px solid var(--sf-glass-border); color: var(--sf-text); }
  [data-theme="simplefolio"] .sf-shot-stats b { font-size: 14px; color: var(--sf-ink); }
  /* Tones: the FlowSense in/out flow colours as a faint wash inside the frosted card */
  [data-theme="simplefolio"] .sf-shot--teal .sf-shot-body { background: radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--sf-in) 24%, transparent), transparent 60%); }
  [data-theme="simplefolio"] .sf-shot--teal .sf-shot-initial { color: var(--sf-in); opacity: 0.22; }
  [data-theme="simplefolio"] .sf-shot--navy .sf-shot-body { background: radial-gradient(120% 90% at 0% 100%, color-mix(in srgb, var(--sf-out) 24%, transparent), transparent 60%); }
  [data-theme="simplefolio"] .sf-shot--light .sf-shot-body { background: radial-gradient(110% 80% at 50% 0%, rgba(255, 255, 255, 0.07), transparent 70%); }
  [data-theme="simplefolio"][data-mode="light"] .sf-shot--light .sf-shot-body { background: radial-gradient(110% 80% at 50% 0%, color-mix(in srgb, var(--sf-accent) 10%, transparent), transparent 70%); }

  /* Role details: hidden on screen (the browser dialog shows a copy), always printed */
  [data-theme="simplefolio"] .sf-details { display: none; }
  [data-theme="simplefolio"] .sf-details-inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; text-align: left; }
  [data-theme="simplefolio"] .sf-detail-role { padding-top: 28px; }
  [data-theme="simplefolio"] .sf-detail-role:first-child { padding-top: 8px; }
  [data-theme="simplefolio"] .sf-detail-role h4 { margin: 0 0 4px; font-size: 17px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; color: var(--sf-ink); }
  [data-theme="simplefolio"] .sf-detail-meta { font-family: var(--sf-mono); font-size: 11.5px; color: var(--sf-muted); margin-bottom: 12px; }
  [data-theme="simplefolio"] .sf-detail-role ul { list-style: none; margin: 0; padding: 0; }
  [data-theme="simplefolio"] .sf-detail-role li { position: relative; padding-left: 16px; margin-bottom: 9px; font-size: 14px; line-height: 1.55; color: var(--sf-text); }
  [data-theme="simplefolio"] .sf-detail-role li::before { content: ""; position: absolute; left: 0; top: 8px; width: 5px; height: 5px; background: var(--sf-accent); }

  /* Company website card */
  [data-theme="simplefolio"] .sf-shot-link { display: block; width: 100%; padding: 0; border: 0; background: none; font: inherit; color: inherit; text-align: inherit; cursor: zoom-in; }
  [data-theme="simplefolio"] .sf-shot-link:focus-visible { outline: 2px solid var(--sf-primary); outline-offset: 4px; border-radius: 4px; }
  [data-theme="simplefolio"] .sf-shot-bar .sf-url { font-family: var(--sf-mono); }
  [data-theme="simplefolio"] .sf-url-tag {
    flex: none; padding: 2px 6px; border: 1px solid color-mix(in srgb, var(--sf-accent) 45%, transparent); border-radius: 2px;
    font-family: var(--sf-mono); font-size: 10px; font-style: normal; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sf-accent); white-space: nowrap;
  }
  [data-theme="simplefolio"] .sf-expand {
    margin-left: auto; flex: none; font-family: var(--sf-mono); font-size: 11px; letter-spacing: 0.04em; color: var(--sf-muted);
    opacity: 0; transform: translateX(-4px); transition: opacity 0.2s, transform 0.2s;
  }
  [data-theme="simplefolio"] .sf-shot-link:hover .sf-expand,
  [data-theme="simplefolio"] .sf-shot-link:focus-visible .sf-expand { opacity: 1; transform: none; color: var(--sf-ink); }
  [data-theme="simplefolio"] .sf-site { position: relative; flex: 1; min-height: 0; overflow: hidden; background: var(--sf-display); }
  [data-theme="simplefolio"] .sf-site img { display: block; width: 100%; height: auto; transform: translateY(0); transition: transform 2.4s cubic-bezier(0.45, 0, 0.2, 1); }
  /* Hovering scrolls the page a little, like skimming the site */
  [data-theme="simplefolio"] .sf-shot-link:hover .sf-site img { transform: translateY(-18%); }
  [data-theme="simplefolio"] .sf-site-caption {
    position: absolute; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; gap: 6px; padding: 56px 28px 22px; text-align: left;
    background: linear-gradient(to top, var(--sf-paper) 8%, color-mix(in srgb, var(--sf-paper) 70%, transparent) 55%, transparent);
  }
  /* Light mode: a short, tight fade only behind the caption text, so the dark screenshots
     aren't washed out by a tall pale gradient. */
  [data-theme="simplefolio"][data-mode="light"] .sf-site-caption {
    padding-top: 22px;
    background: linear-gradient(to top, color-mix(in srgb, var(--sf-paper) 94%, transparent) 55%, color-mix(in srgb, var(--sf-paper) 60%, transparent) 80%, transparent);
  }
  [data-theme="simplefolio"] .sf-site-role { font-size: 15px; font-weight: 600; letter-spacing: -0.01em; color: var(--sf-ink); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  /* Expanded browser window */
  html:has(#sf-browser[open]) { overflow: hidden; }
  [data-theme="simplefolio"] .sf-browser {
    position: fixed; inset: 0; margin: auto; width: min(1320px, calc(100vw - 48px)); height: calc(100vh - 48px); height: calc(100dvh - 48px);
    max-width: none; max-height: none; padding: 0; overflow: hidden; display: none; flex-direction: column;
    color: var(--sf-text); background: var(--sf-paper); border: 1px solid var(--sf-rule); border-radius: 6px;
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.55); text-align: left;
  }
  [data-theme="simplefolio"] .sf-browser[open] { display: flex; }
  [data-theme="simplefolio"] .sf-browser::backdrop { background: rgba(0, 0, 0, 0.55); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  [data-theme="simplefolio"][data-mode="light"] .sf-browser::backdrop { background: rgba(20, 20, 20, 0.28); }
  [data-theme="simplefolio"] .sf-browser-bar {
    flex: none; display: flex; align-items: center; gap: 10px; height: 52px; padding: 0 12px 0 18px;
    background: var(--sf-wash); border-bottom: 1px solid var(--sf-rule);
  }
  [data-theme="simplefolio"] .sf-dot { width: 12px; height: 12px; padding: 0; border: 0; border-radius: 50%; background: var(--sf-rule); flex: none; }
  [data-theme="simplefolio"] .sf-dot--close { background: #ff6159; cursor: pointer; }
  [data-theme="simplefolio"] .sf-dot--close + .sf-dot { background: #ffbd2e; }
  [data-theme="simplefolio"] .sf-dot--close + .sf-dot + .sf-dot { background: #28c941; }
  [data-theme="simplefolio"] .sf-browser-nav { display: flex; gap: 2px; margin-left: 10px; }
  [data-theme="simplefolio"] .sf-browser-step,
  [data-theme="simplefolio"] .sf-browser-close {
    display: grid; place-items: center; width: 32px; height: 30px; padding: 0; border: 1px solid transparent; border-radius: 4px;
    background: none; color: var(--sf-ink); font: 500 15px/1 var(--sf-mono); cursor: pointer;
  }
  [data-theme="simplefolio"] .sf-browser-step:hover:not(:disabled),
  [data-theme="simplefolio"] .sf-browser-close:hover { border-color: var(--sf-rule); background: var(--sf-paper); }
  [data-theme="simplefolio"] .sf-browser-step:disabled { color: var(--sf-rule); cursor: default; }
  [data-theme="simplefolio"] .sf-browser-url {
    flex: 1; min-width: 0; display: flex; align-items: center; gap: 8px; height: 32px; padding: 0 12px; margin: 0 6px;
    background: var(--sf-paper); border: 1px solid var(--sf-rule); border-radius: 4px; color: var(--sf-graphite);
    font-family: var(--sf-mono); font-size: 12.5px; white-space: nowrap; overflow: hidden;
  }
  [data-theme="simplefolio"] .sf-browser-url svg { flex: none; color: var(--sf-in); }
  [data-theme="simplefolio"] .sf-browser-url span { overflow: hidden; text-overflow: ellipsis; }
  [data-theme="simplefolio"] .sf-browser-open {
    flex: none; padding: 8px 12px; border: 1px solid var(--sf-rule); border-radius: 4px; background: var(--sf-paper);
    font-size: 13px; font-weight: 600; color: var(--sf-ink); white-space: nowrap;
  }
  [data-theme="simplefolio"] .sf-browser-open:hover { border-color: var(--sf-ink); }
  [data-theme="simplefolio"] .sf-browser-open[hidden] { display: none; }
  [data-theme="simplefolio"] .sf-browser-body { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) 440px; }
  [data-theme="simplefolio"] .sf-browser-page { min-height: 0; overflow-y: auto; overscroll-behavior: contain; background: var(--sf-display); }
  [data-theme="simplefolio"] .sf-browser-page img { display: block; width: 100%; height: auto; }
  [data-theme="simplefolio"] .sf-browser-offline {
    height: 100%; min-height: 320px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;
    background-image: radial-gradient(var(--sf-dot) 1px, transparent 1.3px); background-size: 22px 22px;
  }
  [data-theme="simplefolio"] .sf-browser-offline span { font-size: 160px; font-weight: 700; letter-spacing: -0.06em; line-height: 1; color: var(--sf-rule); }
  [data-theme="simplefolio"] .sf-browser-offline p { margin: 0; font-family: var(--sf-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sf-muted); }
  [data-theme="simplefolio"] .sf-browser-exp:focus { outline: none; }
  [data-theme="simplefolio"] .sf-browser-exp {
    min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 32px 32px 40px;
    border-left: 1px solid var(--sf-rule); background: var(--sf-paper);
  }
  [data-theme="simplefolio"] .sf-browser-label { margin: 0 0 12px; font-family: var(--sf-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sf-ash); }
  [data-theme="simplefolio"] .sf-browser-title { margin: 0 0 8px; font-size: 30px; font-weight: 700; letter-spacing: -0.045em; line-height: 1.08; color: var(--sf-ink); }
  [data-theme="simplefolio"] .sf-browser-meta { margin: 0 0 20px; padding-bottom: 20px; border-bottom: 1px solid var(--sf-rule); font-family: var(--sf-mono); font-size: 12px; color: var(--sf-primary); }
  ::view-transition-group(sf-browser) { animation-duration: 0.45s; animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1); }

  /* Projects */
  [data-theme="simplefolio"] .sf-proj-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px 40px; text-align: left; }
  [data-theme="simplefolio"] .sf-proj { min-width: 0; }
  [data-theme="simplefolio"] .sf-proj:only-child { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 0 40px; align-items: start; }
  [data-theme="simplefolio"] .sf-proj:only-child > .sf-shot-link { grid-row: 1 / span 4; }
  [data-theme="simplefolio"] .sf-proj:only-child .sf-shot { margin-bottom: 0; }
  [data-theme="simplefolio"] .sf-proj .sf-shot { margin-bottom: 24px; }
  [data-theme="simplefolio"] .sf-proj .sf-project-lead { margin-bottom: 0; }

  /* Posts (X timeline) */
  [data-theme="simplefolio"] .sf-posts { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 40px; align-items: start; text-align: left; }
  [data-theme="simplefolio"] .sf-posts-label { margin: 0 0 12px; font-family: var(--sf-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sf-ash); }
  [data-theme="simplefolio"] .sf-posts-text { margin: 0 0 24px; font-size: 20px; line-height: 1.45; letter-spacing: -0.015em; color: var(--sf-ink); }
  [data-theme="simplefolio"] .sf-posts-list { display: grid; gap: 20px; }
  [data-theme="simplefolio"] .sf-post { padding: 22px 24px 18px; }
  [data-theme="simplefolio"] .sf-post-head { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
  [data-theme="simplefolio"] .sf-post-avatar { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--sf-rule); flex: none; }
  [data-theme="simplefolio"] .sf-post-who { display: flex; flex-direction: column; min-width: 0; line-height: 1.3; }
  [data-theme="simplefolio"] .sf-post-who b { display: inline-flex; align-items: center; gap: 4px; font-size: 15px; font-weight: 600; color: var(--sf-ink); }
  [data-theme="simplefolio"] .sf-post-check { color: var(--sf-primary); }
  [data-theme="simplefolio"] .sf-post-who span { font-family: var(--sf-mono); font-size: 12px; color: var(--sf-muted); }
  [data-theme="simplefolio"] .sf-post-x { margin-left: auto; color: var(--sf-muted); display: grid; place-items: center; width: 34px; height: 34px; border-radius: 4px; transition: color 0.2s, background 0.2s; }
  [data-theme="simplefolio"] .sf-post-x:hover { color: var(--sf-ink); background: var(--sf-glass); }
  [data-theme="simplefolio"] .sf-post-text { margin: 0 0 16px; font-size: 15.5px; line-height: 1.6; color: var(--sf-ink); white-space: pre-line; overflow-wrap: anywhere; }
  [data-theme="simplefolio"] .sf-post-text a { color: var(--sf-primary); }
  [data-theme="simplefolio"] .sf-post-photos { display: grid; gap: 6px; margin-bottom: 14px; border: 1px solid var(--sf-rule); border-radius: 4px; overflow: hidden; }
  [data-theme="simplefolio"] .sf-post-photos img { display: block; width: 100%; height: auto; }
  [data-theme="simplefolio"] .sf-post-foot { display: flex; align-items: center; gap: 18px; font-family: var(--sf-mono); font-size: 12px; color: var(--sf-muted); }
  [data-theme="simplefolio"] .sf-post-foot a { margin-left: auto; color: var(--sf-primary); }
  [data-theme="simplefolio"] .sf-posts-fallback {
    min-height: 220px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px;
    color: var(--sf-muted); font-family: var(--sf-mono); font-size: 13px; transition: color 0.2s;
  }
  [data-theme="simplefolio"] .sf-posts-fallback:hover { color: var(--sf-ink); }

  /* GitHub contributions */
  [data-theme="simplefolio"] .sf-gh { margin-top: 72px; padding-top: 28px; border-top: 1px solid var(--sf-rule); text-align: left; }
  [data-theme="simplefolio"] .sf-gh-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 18px; margin-bottom: 20px; }
  [data-theme="simplefolio"] .sf-gh-label { margin: 0; font-family: var(--sf-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sf-ash); }
  [data-theme="simplefolio"] .sf-gh-total { margin: 0; font-size: 15px; color: var(--sf-text); }
  [data-theme="simplefolio"] .sf-gh-total b { color: var(--sf-ink); font-weight: 600; }
  [data-theme="simplefolio"] .sf-gh-head .sf-cta--link { margin-left: auto; font-size: 14px; }
  [data-theme="simplefolio"] .sf-gh-scroll { overflow-x: auto; padding-bottom: 6px; direction: rtl; }
  [data-theme="simplefolio"] .sf-gh-chart { direction: ltr; --sf-gh-cell: 11px; --sf-gh-gap: 4px; min-width: max-content; }
  [data-theme="simplefolio"] .sf-gh-months,
  [data-theme="simplefolio"] .sf-gh-grid {
    /* Cells stretch to fill the width, but never shrink below --sf-gh-cell (then it scrolls) */
    display: grid; grid-template-columns: repeat(var(--sf-gh-weeks), minmax(var(--sf-gh-cell), 1fr)); column-gap: var(--sf-gh-gap);
  }
  [data-theme="simplefolio"] .sf-gh-months { margin-bottom: 8px; font-family: var(--sf-mono); font-size: 11px; color: var(--sf-muted); }
  /* Zero-width labels overflow their column so they never widen it */
  [data-theme="simplefolio"] .sf-gh-months span { grid-row: 1; width: 0; white-space: nowrap; overflow: visible; }
  [data-theme="simplefolio"] .sf-gh-grid { grid-template-rows: repeat(7, auto); row-gap: var(--sf-gh-gap); }
  [data-theme="simplefolio"] .sf-gh-grid i { aspect-ratio: 1; }
  [data-theme="simplefolio"] .sf-gh i { display: block; border-radius: 2px; background: var(--sf-wash); outline: 1px solid color-mix(in srgb, var(--sf-ink) 4%, transparent); outline-offset: -1px; }
